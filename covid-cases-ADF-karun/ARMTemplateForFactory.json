				"typeProperties": {
					"url": "[parameters('ls_adls_covid19reportingkarundl_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_covid19reportingkarundl_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
